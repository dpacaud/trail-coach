# Copier en .env et remplir. .env est ignore par git.
#
# Creer une application sur https://www.strava.com/settings/api
# puis recuperer Client ID et Client Secret.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Port du serveur local qui recoit le retour OAuth (doit correspondre
# au "Authorization Callback Domain" de l'app Strava : localhost).
STRAVA_CALLBACK_PORT=8723

# Ou sont stockes jetons et donnees (hors depot).
TRAILCOACH_DATA_DIR=./data

# Parametres physiologiques de l'athlete.
# HR_MAX : la valeur OBSERVEE, pas une estimation sur l'age.
# LTHR   : FC moyenne tenue sur un effort maximal d'environ 60 min.
ATHLETE_HR_MAX=196
ATHLETE_LTHR=178
ATHLETE_HR_REST=61
ATHLETE_WEIGHT_KG=84

# Fuseau local pour convertir les horodatages FIT (stockes en UTC).
ATHLETE_TZ=Europe/Paris
